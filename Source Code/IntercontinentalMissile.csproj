<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>IntercontinentalMissile</AssemblyName>
    <RootNamespace>IntercontinentalMissile</RootNamespace>
    <LangVersion>latest</LangVersion>
    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referências do RimWorld via NuGet. Não precisa apontar para a pasta do jogo. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
    <!-- Harmony só para compilar; em jogo usa-se o mod Harmony (dependência no About.xml). -->
    <PackageReference Include="Lib.Harmony" Version="2.3.*" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
